# Copiá este archivo como backend/.env (start-windows.bat lo hace solo)

# Coincide con docker-compose.yml. Si usás Supabase, pegá acá su cadena de conexión.
DATABASE_URL="postgresql://turnify:turnify@localhost:5432/turnify?schema=public"

# Dirección del front. Solo se aceptan pedidos que vengan de acá.
APP_ORIGIN="http://localhost:5173"

PORT=4000

# "production" activa cookies seguras (solo HTTPS)
NODE_ENV="development"
